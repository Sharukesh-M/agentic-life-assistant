# ==========================================
# JARVIX Environment Configuration Template
# ==========================================

# Database Configuration (PostgreSQL with pgvector / SQLite local fallback)
# Production Example: postgresql://jarvix_user:secure_password@localhost:5432/jarvix_db
DATABASE_URL=sqlite:///./jarvix.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# LLM Provider Configuration (mock | openai | anthropic | gemini | openai-compatible)
LLM_PROVIDER=mock
LLM_MODEL=jarvix-default-model
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=
LLM_TIMEOUT=30.0
LLM_TEMPERATURE=0.0

# Backend API Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
